# Project Midas — Environment Configuration
# Author: Atharva Kishor Jadhav (AJ)
# ---------------------------------------------------------------
# Copy this file to .env and fill in JWT_SECRET before first launch.
# Never commit .env to version control.

# --- Ollama / VRAM ---
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Hard cap: only one model loaded at a time — prevents OOM on 6GB VRAM
OLLAMA_MAX_LOADED_MODELS=1
# Embedding model runs CPU-only; this env var is read by vram_manager.py
OLLAMA_EMBED_NUM_GPU_LAYERS=0

# --- Model names ---
MODEL_REASONING=qwen2.5:0.5b
MODEL_VISION=moondream
MODEL_EMBED=nomic-embed-text

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Qdrant ---
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=midas_docs

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=5f58806512b25b8c5bda3ced3e3d00c0e6f567437ba8c89d49c8964eb052d1d5
JWT_EXPIRE_MINUTES=480
USERS_FILE=./users.json

# --- Sandbox ---
OUTPUTS_DIR=./outputs
TIER_B_DISPATCH_LOG=./tier_b_dispatch.log
# Shared secret between the main worker and the Tier B dispatcher sidecar
DISPATCHER_SECRET=a8461a611f8a9469453aa2ebc07554c8f48477ac24af8d4736b779bbea2c04c9
DISPATCHER_URL=http://dispatcher:8001

# --- Groundedness ---
GROUND_CHECK_THRESHOLD=0.65

# --- Frontend ---
API_URL=http://api:8000
